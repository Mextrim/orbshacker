{
  "name": "orbshacker",
  "version": "2.5.0",
  "description": "Discord Quests & Profile Badges Spoofer (Rust + Electron)",
  "main": "main.js",
  "author": "Mextrim",
  "license": "GPL-3.0",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build:portable": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.mextrim.orbshacker",
    "productName": "orbshacker",
    "directories": {
      "output": "../dist"
    },
    "files": [
      "main.js",
      "updater.js",
      "preload.js",
      "renderer/**/*",
      "assets/**/*",
      "bin/**/*"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "orbshacker-portable.exe"
    }
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  }
}

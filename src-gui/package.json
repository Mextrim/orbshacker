{
  "name": "orbshacker",
  "version": "2.8.0",
  "description": "Discord Quests & Profile Badges Spoofer (Rust + Electron)",
  "main": "main.js",
  "author": "Mextrim",
  "license": "GPL-3.0",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build:portable": "electron-builder --win portable",
    "build:win": "electron-builder --win portable zip",
    "build:linux": "electron-builder --linux AppImage tar.gz"
  },
  "build": {
    "appId": "com.mextrim.orbshacker",
    "productName": "orbshacker",
    "directories": {
      "output": "../dist"
    },
    "files": [
      "main.js",
      "updater.js",
      "discord-account.js",
      "preload.js",
      "renderer/**/*",
      "assets/**/*",
      "bin/**/*"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "orbshacker-portable.exe"
    },
    "linux": {
      "icon": "assets/icon.png",
      "category": "Utility",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  }
}
